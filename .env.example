# Copia este archivo a .env y completa tu clave (nunca subas .env al repo).
GROQ_API_KEY=tu_clave_de_groq

# Opcionales
# GROQ_MODEL=openai/gpt-oss-120b
# API_BASE_URL=http://localhost:8000

# Si defines API_KEY, la API exige la cabecera X-API-Key en /inventory y /products,
# y el agente la envía automáticamente. Sin ella, la API queda abierta (uso local).
# API_KEY=una_clave_larga_y_aleatoria
